{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sentinelops.ai/schemas/events/v1/incident_event.json",
  "title": "IncidentEvent",
  "allOf": [{ "$ref": "base_event.json" }],
  "properties": {
    "event_type": { "const": "incident" },
    "severity": { "enum": ["warning", "error", "critical"] },
    "payload": {
      "type": "object",
      "required": ["incident_id", "title", "status"],
      "properties": {
        "incident_id": { "type": "string", "format": "uuid" },
        "title": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "investigating", "mitigated", "resolved"] },
        "root_cause": { "type": ["string", "null"] },
        "affected_services": { "type": "array", "items": { "type": "string" } },
        "cascade_chain": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "service": { "type": "string" },
              "order": { "type": "integer" },
              "failure_mode": { "type": "string" }
            }
          }
        },
        "confidence_score": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}

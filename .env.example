# =============================================================================
# SentinelOps AI — Environment Configuration
# =============================================================================

# --- Application ---
APP_NAME=SentinelOps AI
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=json
APP_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sentinelops
POSTGRES_PASSWORD=sentinelops
POSTGRES_DB=sentinelops
DATABASE_URL=postgresql+asyncpg://sentinelops:sentinelops@localhost:5432/sentinelops

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6380/0

# --- Redis Streams (consumer groups) ---
STREAM_EVENTS_RAW=so:events:raw
STREAM_EVENTS_ENRICHED=so:events:enriched
STREAM_METRICS=so:metrics
STREAM_CORRELATION=so:correlation
STREAM_INCIDENTS=so:incidents
STREAM_AI_TASKS=so:ai:tasks
STREAM_AI_RESULTS=so:ai:results
STREAM_TOPOLOGY=so:topology
STREAM_REPLAY=so:replay
STREAM_METRICS_EVENTS=metrics.events
STREAM_TOPOLOGY_EVENTS=topology.events
STREAM_ANOMALY_EVENTS=anomaly.events
STREAM_INCIDENT_EVENTS=incident.events
STREAM_RCA_EVENTS=rca.events
STREAM_DEAD_LETTER=dlq.events
CONSUMER_GROUP_DLQ=sentinelops-dlq
STREAM_RETRY_MAX_ATTEMPTS=3
STREAM_RETRY_BACKOFF_SECONDS=2
INGESTION_CORRELATION_WINDOW_SECONDS=120
LOKI_QUERY_LIMIT=500
PROMETHEUS_POLL_INTERVAL_SECONDS=15
CONSUMER_GROUP_COLLECTOR=sentinelops-collector
CONSUMER_GROUP_CORRELATION=sentinelops-correlation
CONSUMER_GROUP_AI=sentinelops-ai
CONSUMER_GROUP_REPLAY=sentinelops-replay
STREAM_MAX_LEN=100000

# --- Kubernetes ---
K8S_IN_CLUSTER=false
K8S_KUBECONFIG=
K8S_NAMESPACE=default
K8S_WATCH_TIMEOUT_SECONDS=300
K8S_COLLECT_INTERVAL_SECONDS=15

# --- Prometheus ---
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_QUERY_TIMEOUT_SECONDS=30
PROMETHEUS_SCRAPE_INTERVAL=15s

# --- Loki ---
LOKI_URL=http://localhost:3100
LOKI_QUERY_TIMEOUT_SECONDS=30

# --- Ollama / AI ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_FALLBACK_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_TOKENS=2048
AI_AGENT_CONCURRENCY=3
AI_ENABLE_GPU=true

# --- Feature Flags ---
FEATURE_NLP_ASSISTANT=true
FEATURE_REPLAY_ENGINE=true
FEATURE_AI_AGENTS=true
FEATURE_DEPENDENCY_GRAPH=true
FEATURE_ANOMALY_DETECTION=true

# --- Anomaly Detection ---
ANOMALY_CPU_THRESHOLD_PERCENT=85
ANOMALY_MEMORY_THRESHOLD_PERCENT=90
ANOMALY_RESTART_BURST_COUNT=3
ANOMALY_RESTART_WINDOW_SECONDS=300
ANOMALY_ZSCORE_THRESHOLD=2.5

# --- Replay ---
REPLAY_BUFFER_HOURS=24
REPLAY_SNAPSHOT_INTERVAL_SECONDS=60
REPLAY_MAX_EVENTS_PER_INCIDENT=50000

# --- WebSocket ---
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_MAX_CONNECTIONS=500

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
